{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of participant emails"
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_group": {
      "type": "boolean",
      "default": false
    },
    "group_name": {
      "type": "string"
    },
    "last_message": {
      "type": "string"
    },
    "last_message_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "participants"
  ]
}