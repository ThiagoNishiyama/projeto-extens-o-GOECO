{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "like",
        "comment",
        "message",
        "points",
        "negotiation",
        "challenge"
      ]
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "link": {
      "type": "string"
    },
    "from_user": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ]
}